<mxfile host="app.diagrams.net" modified="2026-10-08T00:00:00.000Z" agent="claude-code" version="24.7.0" type="device">
  <diagram name="AI Support Triage Agent - Flow" id="triage-flow-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AI Support Triage Agent — Processing Flow" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="New message arrives&#10;(Gmail, under the Triage-Demo label)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="Classify message&#10;(LLM gateway: Claude / Gemini / Groq —&#10;intent, urgency, confidence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="Escalate?&#10;(defect_complaint, OR&#10;confidence &lt; threshold)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="305" y="270" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Retrieve top-matching KB article&#10;(TF-IDF + cosine similarity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="Draft reply grounded ONLY in&#10;the retrieved KB content (LLM gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="520" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="Create a real Gmail draft&#10;(never auto-sent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="Create monday.com item&#10;status = Draft Ready for Approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="Mark Gmail message Processed&#10;(so it's never reprocessed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="820" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="Human reviews the draft&#10;in Gmail's Drafts folder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="920" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="Human sends it?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="1020" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="Next sent-detection poll checks the&#10;draft's underlying message labels&#10;(DRAFT gone, SENT present)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1150" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n12" value="Update monday.com item&#10;status = Sent" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1260" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="Apply the Needs-Human&#10;Gmail label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="Create monday.com item&#10;status = Escalated - Needs Human" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="520" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Mark Gmail message Processed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="620" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="Human handles it directly in Gmail&#10;(no AI draft is ever generated)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="720" width="220" height="60" as="geometry" />
        </mxCell>

