# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider powers classification/drafting: claude, gemini, or groq.
# Only the active provider's key below is required.
LLM_PROVIDER=claude

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Gemini API (aistudio.google.com) - free tier, no card needed, but capped
# at 20 requests/day on newer models, too small for a full pipeline run
GOOGLE_API_KEY=

# Groq API (console.groq.com/keys) - free tier, no card needed, much higher
# daily request limit than Gemini's free tier
GROQ_API_KEY=

# Gmail API: path to the OAuth client file downloaded from Google Cloud
# Console (Desktop app type), and where the long-lived token gets cached
# after the first interactive login.
GMAIL_OAUTH_CLIENT_PATH=credentials.json
GMAIL_TOKEN_CACHE_PATH=gmail_token.json
GMAIL_LABEL=Triage-Demo
GMAIL_PROCESSED_LABEL=Processed
GMAIL_ESCALATION_LABEL=Needs-Human

# monday.com (Free plan). Personal API token from
# https://<your-account>.monday.com/apps/manage/tokens
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# Supabase (free tier). Project Settings -> API in the Supabase
# dashboard. Use the service_role key, not anon, this is a backend
# script, not a browser client. Holds the knowledge-base articles
# (see scripts/migrate_kb_to_supabase.py for the one-time migration
# from data/kb_articles.json).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Slack incoming webhook (optional). If left blank, the pipeline runs
# normally with no alerts, just the monday.com board and Gmail Drafts
# folder to check manually. Create one at
# https://api.slack.com/apps -> your app -> Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Poll intervals, in seconds
INBOX_POLL_INTERVAL_SECONDS=120
SENT_CHECK_POLL_INTERVAL_SECONDS=300

# Escalation
CONFIDENCE_ESCALATION_THRESHOLD=0.6
